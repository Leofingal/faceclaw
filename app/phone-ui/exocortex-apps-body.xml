<!--
  THE APP LIST ITSELF, as a component, because it is now in two places.

  Round 3 made this the phone's home screen: main-page.xml shows it as the
  body you land on at boot and the body the header's "Exocortex" returns to.
  It is also still the whole of phone-ui/exocortex-apps-page, which
  exocortex-settings-page's "Apps" row navigates to. Same markup, same view
  model class, one definition — a copy-paste would have drifted the moment
  either one was touched.

  Each row does three things: TAP IT to open the app on the glasses (always
  available, hidden or not — this is what makes hiding safe), the SWITCH
  controls whether it appears in the glasses' primary app list, and ∧ / ∨
  move it within that list. Both list controls are shared state with the
  glasses, so a change here shows on the lens with no syncing step.

  The order is changed with buttons rather than by dragging: a deliberate
  substitution for the pilot's drag handle, not an oversight — see the view
  model's header for why.

  Binds an ExocortexAppsViewModel. On the page that is the page's own binding
  context; on main-page it is MainViewModel's `appList` member, set on the tag.
-->
<ScrollView xmlns="http://schemas.nativescript.org/tns.xsd">
    <StackLayout class="home-body">

        <Label class="home-row-meta" textWrap="true"
            text="The switch controls whether an app appears in the glasses' app list. It does not uninstall or disable anything — tap any row here to open that app on the glasses, in the list or not." />

        <Label text="{{ status }}" visibility="{{ statusVisibility }}"
            class="home-row-meta" textWrap="true" />

        <Repeater items="{{ rows }}">
            <Repeater.itemsLayout>
                <StackLayout />
            </Repeater.itemsLayout>
            <Repeater.itemTemplate>
                <GridLayout columns="auto,*,auto,auto" class="exo-row">
                    <Switch col="0" checked="{{ visible }}" checkedChange="{{ onCheckedChange }}"
                        verticalAlignment="center" />
                    <!-- The tap target is the name block, not the whole
                         row: a row-level tap would also fire when the
                         thumb lands on the switch or a move button. -->
                    <StackLayout col="1" marginLeft="10" tap="{{ onRowTap }}">
                        <Label text="{{ title }}" class="home-row-title" textWrap="true" />
                        <Label text="{{ meta }}" class="home-row-meta" textWrap="true" />
                    </StackLayout>
                    <Button col="2" text="&#x2227;" tap="{{ onMoveUpTap }}" visibility="{{ upVisibility }}"
                        class="app-order-button" verticalAlignment="center" />
                    <Button col="3" text="&#x2228;" tap="{{ onMoveDownTap }}" visibility="{{ downVisibility }}"
                        class="app-order-button" verticalAlignment="center" />
                </GridLayout>
            </Repeater.itemTemplate>
        </Repeater>

    </StackLayout>
</ScrollView>
