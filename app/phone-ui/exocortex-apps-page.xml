<!--
  "Apps on the glasses" as a standalone page, reached from
  exocortex-settings-page's "Apps" row.

  Round 3 moved this same list onto the phone's home screen (main-page.xml
  shows phone-ui/exocortex-apps-body as the body you land on), so this page is
  now a second door onto one list rather than the only one. It is kept because
  the Settings path to it is a real, discoverable route and nothing about it
  broke; the markup lives in the shared component so the two cannot drift.
-->
<Page xmlns="http://schemas.nativescript.org/tns.xsd" xmlns:ui="phone-ui" navigatingTo="navigatingTo">
    <ActionBar title="Apps on the glasses" />

    <ui:exocortex-apps-body />
</Page>
