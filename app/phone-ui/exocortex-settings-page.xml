<!--
  Exocortex's Settings, on the phone — and as of 2026-09-03 THE settings
  surface, not one of two. The separate Settings app that opened on the
  glasses is unlisted (apps/settings/index.ts), and everything it held is
  here, editable with a thumb.

  Two halves, deliberately different in kind:

    the catalogue    every real setting, generated from ui/settings-catalog,
                     which the glasses panel renders from as well. Generated
                     rather than hand-written precisely so the two cannot
                     drift now that one of them is the only one reachable.
    the rest         Notifications, Apps and the gesture reference: phone-only
                     screens with no glasses equivalent, so they stay written
                     out.
-->
<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" unloaded="unloaded">
    <!-- "Exocortex settings", not "Settings": round 3 made Settings itself a
         page (phone-ui/settings-hub-page, faceclaw's old hub), and this one
         sits inside it. Two screens both titled Settings, one nested in the
         other, is the kind of small lie that costs an hour later. -->
    <ActionBar title="Exocortex settings" />

    <ScrollView>
        <StackLayout class="home-body">

            <!--
              EVERY SETTING, FROM THE SHARED CATALOGUE (2026-09-03).

              This used to be a hand-written subset — Glasses and Display —
              sitting alongside a separate Settings APP that opened on the
              glasses and owned everything else. Chris, having gone looking:
              "I want those settings to be settings so they should be under
              the gear, instead of being a separate app that opens on the
              glasses... they should be all editable on the phone side
              without any glasses interaction."

              So the categories now come from ui/settings-catalog, which the
              glasses panel renders from as well — one definition, so the
              surface the wearer can actually reach cannot fall behind. The
              rows below are generated rather than written out (the note this
              file used to carry about hand-written rows no longer applies: a
              generated list is what stops the two surfaces drifting, and the
              page can be checked on a real phone over adb).

              Every row WRITES. An enum cycles on tap, a boolean is a Switch,
              a string is a TextField you type into here — the earlier round's
              trap was porting labels while the write path stayed glasses-only.
            -->
            <Repeater items="{{ settingsRows }}">
                <Repeater.itemsLayout>
                    <StackLayout />
                </Repeater.itemsLayout>
                <Repeater.itemTemplate>
                    <StackLayout>
                        <!-- Category heading. One template for both kinds of
                             row, with the unused half collapsed — a Repeater
                             has only one. -->
                        <StackLayout visibility="{{ headerVisibility }}">
                            <Label text="{{ title }}" class="home-section-title" />
                            <Label text="{{ description }}" class="home-row-meta" textWrap="true" />
                        </StackLayout>

                        <GridLayout columns="*,auto" class="exo-row"
                            visibility="{{ rowVisibility }}" tap="{{ onRowTap }}">
                            <StackLayout col="0">
                                <Label text="{{ title }}" class="home-row-title" textWrap="true" />
                                <Label text="{{ description }}" class="home-row-meta" textWrap="true"
                                    visibility="{{ descriptionVisibility }}" />
                                <TextField text="{{ textValue }}" hint="{{ textHint }}"
                                    textChange="{{ onTextChange }}" visibility="{{ textVisibility }}"
                                    secure="{{ textSecure }}" autocorrect="false"
                                    autocapitalizationType="none" class="ghost-setting-field" />
                            </StackLayout>
                            <Label col="1" text="{{ valueLabel }}" class="settings-value"
                                visibility="{{ valueVisibility }}" textWrap="true"
                                verticalAlignment="center" />
                            <Switch col="1" checked="{{ toggleValue }}" checkedChange="{{ onToggleChange }}"
                                visibility="{{ toggleVisibility }}" verticalAlignment="center" />
                        </GridLayout>
                    </StackLayout>
                </Repeater.itemTemplate>
            </Repeater>

            <Label text="Notifications" class="home-section-title" />
            <GridLayout columns="*,auto" class="exo-row" tap="{{ onNotificationSourcesTap }}">
                <StackLayout col="0">
                    <Label text="Notification sources" class="home-row-title" />
                    <Label text="Choose which apps can reach the glasses." class="home-row-meta" textWrap="true" />
                </StackLayout>
                <Label col="1" text="{{ notificationSourcesSummary }}" class="settings-value" verticalAlignment="center" />
            </GridLayout>

            <Label text="Apps" class="home-section-title" />
            <GridLayout columns="*,auto" class="exo-row" tap="{{ onAppListTap }}">
                <StackLayout col="0">
                    <Label text="Apps" class="home-row-title" />
                    <Label text="Which apps the glasses list, in what order — and open any of them from here." class="home-row-meta" textWrap="true" />
                </StackLayout>
                <Label col="1" text="{{ appListSummary }}" class="settings-value" verticalAlignment="center" />
            </GridLayout>

            <!-- The pilot's "Command interactions" reference. Static: it is
                 the same five gestures on every screen, and the per-app
                 version lives on the glasses where the app can supply it. -->
            <Label text="Interface" class="home-section-title" />
            <GridLayout columns="auto,*" class="exo-row">
                <Label col="0" text="Scroll" class="home-row-title" verticalAlignment="center" />
                <Label col="1" text="move through the list" class="home-row-meta" textWrap="true" verticalAlignment="center" />
            </GridLayout>
            <GridLayout columns="auto,*" class="exo-row">
                <Label col="0" text="Tap" class="home-row-title" verticalAlignment="center" />
                <Label col="1" text="select, or dismiss a notification" class="home-row-meta" textWrap="true" verticalAlignment="center" />
            </GridLayout>
            <GridLayout columns="auto,*" class="exo-row">
                <Label col="0" text="Double tap" class="home-row-title" verticalAlignment="center" />
                <Label col="1" text="back out — to the home screen, or off from there" class="home-row-meta" textWrap="true" verticalAlignment="center" />
            </GridLayout>
            <GridLayout columns="auto,*" class="exo-row">
                <Label col="0" text="Long press" class="home-row-title" verticalAlignment="center" />
                <Label col="1" text="clear all notifications, or app specific" class="home-row-meta" textWrap="true" verticalAlignment="center" />
            </GridLayout>
            <GridLayout columns="auto,*" class="exo-row">
                <Label col="0" text="Hold longer" class="home-row-title" verticalAlignment="center" />
                <Label col="1" text="the shell's own escape menu, from anywhere" class="home-row-meta" textWrap="true" verticalAlignment="center" />
            </GridLayout>

        </StackLayout>
    </ScrollView>
</Page>
