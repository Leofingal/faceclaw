<!--
  Ghost's phone-side companion, shown in place of the home hub whenever Ghost
  is the foreground app ON THE GLASSES (main-page.xml swaps them; the signal is
  the shell's foreground window, mirrored through the dashboard snapshot).

  The four-pane carousel from the design pilot — Terminal, Rich view (the
  default), Doc viewer, Settings — with the compose box docked below the three
  content panes and absent on Settings. Panes change by tapping the tab bar or
  swiping the pane area; the pilot's edge arrows are gone, they existed because
  the pilot was a mouse-driven mockup in a browser.

  Binds to GhostCompanionViewModel (set as this component's bindingContext by
  main-page.xml), not to MainViewModel: everything on this screen belongs to
  one app's session, and the hub's own members have no business here.
-->
<GridLayout xmlns="http://schemas.nativescript.org/tns.xsd" rows="auto,*,auto" class="ghost-app">

  <!--
    NO HEADER OF ITS OWN ANY MORE. Round 1 cut this from three stacked rows to
    a wordmark row plus a collapsing status row; Chris, looking at that build,
    still wanted the whole treatment gone, named the two rows specifically
    ("Ghost is open on the glasses", and "Rich view / 20 in the feed - session
    id: ...") and put a number on what should be left: 80-85% content.

    Both rows now live — as one row, shared with every other companion view —
    in phone-ui/exocortex-header.xml, which main-page.xml puts above this
    component. Nothing was moved into this file, deliberately: a header that
    is per-app is a header every future companion has to reinvent.

    Nothing is actually lost with the status row. The pane name was already
    redundant with the highlighted tab immediately below it, and the feed
    count and session id are exactly what the Terminal pane's first three
    lines print — a pane that now renders, which it did not before (see below).
  -->
  <GridLayout row="0" rows="auto" columns="*,*,*,*" class="ghost-tab-bar">
    <Button col="0" text="Terminal" tap="{{ onTerminalTabTap }}" class="{{ terminalTabClass }}" />
    <Button col="1" text="Rich" tap="{{ onRichTabTap }}" class="{{ richTabClass }}" />
    <Button col="2" text="Doc" tap="{{ onDocTabTap }}" class="{{ docTabClass }}" />
    <Button col="3" text="Settings" tap="{{ onSettingsTabTap }}" class="{{ settingsTabClass }}" />
  </GridLayout>

  <!-- The four panes share the star row; only one is visible at a time, so the
       compose bar below keeps the same position however deep a pane scrolls. -->
  <GridLayout row="1" swipe="{{ onPaneSwipe }}">

    <!-- Rich view (round 4): the REAL transcript, every turn, not just the
         glasses' own digest. Tapping a row opens that turn in the Doc
         viewer. See ghost-companion-view-model.ts's own header for why this
         needed a second, separate poll from the glasses' digest one. -->
    <ScrollView visibility="{{ richPaneVisibility }}" loaded="{{ onRichScrollLoaded }}">
      <StackLayout class="ghost-pane-body">
        <Label text="{{ feedEmptyMessage }}" visibility="{{ feedEmptyVisibility }}"
          class="ghost-empty" textWrap="true" />
        <!-- RICH_VIEW_MAX_ROWS caps what actually renders (the Repeater
             below is not virtualized); this says so instead of silently
             dropping older history. -->
        <Label text="{{ olderTurnsHiddenMessage }}" visibility="{{ olderTurnsHiddenVisibility }}"
          class="ghost-empty" textWrap="true" />
        <!--
          ONE ROW PER SEGMENT OF A LOGICAL TURN, NOT ONE PER TRANSCRIPT ENTRY.
          That distinction is the whole fix: a Ghost reply arrives as prose,
          then a tool marker, then more prose, and round 4 gave each of those
          its own equally-weighted card ("80% tool use, and almost no prose
          responses" — Chris, on the shipped build). The view model groups
          them first (transcript-turns.ts's groupTranscript), so consecutive
          prose is already concatenated and only the FIRST row of a turn shows
          the speaker; the rest run straight on.

          A row is prose OR a tool marker, never both — the unused Label
          collapses. That is the same visibility-toggle pattern the rest of
          this file uses, chosen over a Repeater itemTemplateSelector because
          it needs no new mechanism to get the identical result.
        -->
        <Repeater items="{{ turns }}">
          <Repeater.itemsLayout>
            <StackLayout />
          </Repeater.itemsLayout>
          <Repeater.itemTemplate>
            <StackLayout class="{{ rowClass }}" tap="{{ onRowTap }}">
              <Label text="{{ who }}" visibility="{{ whoVisibility }}" class="ghost-seg-who" />
              <Label text="{{ proseText }}" visibility="{{ proseVisibility }}"
                class="{{ proseClass }}" textWrap="true" />
              <Label text="{{ toolText }}" visibility="{{ toolVisibility }}"
                class="ghost-seg-tool" textWrap="true" />
            </StackLayout>
          </Repeater.itemTemplate>
        </Repeater>
      </StackLayout>
    </ScrollView>

    <!--
      Terminal: the same feed undigested. Not a live PTY — see the view
      model's header for why the glasses client has no such stream.

      textWrap IS LOAD-BEARING HERE, NOT COSMETIC. Chris, on the shipped
      build: "Terminal view seems not to exist at all (just says host ... in a
      single row)". That is not the undigested feed reading as sparse — it is
      this Label printing line 1 of terminalText and dropping the rest.
      NativeScript's Android Label calls setSingleLine(true) in
      initNativeView(); `textWrap="true"` (whiteSpace: normal) is the only
      thing that undoes it. Every other multi-line Label in this file already
      set it; this one did not, so a multi-line string rendered as one
      ellipsized row — and terminalText's first line is literally
      `host    <address>`, which is exactly the symptom reported.

      The horizontal ScrollView that used to wrap this Label is gone too. It
      could not have helped (a single-line Label has nothing to scroll to) and
      it cost something real: dynamic-companion-return.md flagged it as the
      reason pane-to-pane SWIPE did not work on the Terminal pane, because a
      horizontal ScrollView eats horizontal drags. Wrapping long lines instead
      of scrolling them costs the monospace column alignment on the few lines
      wide enough to wrap, and shows everything rather than nothing.
    -->
    <ScrollView visibility="{{ terminalPaneVisibility }}" orientation="vertical">
      <Label text="{{ terminalText }}" textWrap="true" class="ghost-terminal" />
    </ScrollView>

    <!-- Doc viewer: one turn's full text, pinned or following the lens. -->
    <GridLayout rows="auto,*" visibility="{{ docPaneVisibility }}">
      <GridLayout row="0" rows="auto" columns="*,auto" class="ghost-doc-bar">
        <Label col="0" text="{{ docTitle }}" class="ghost-doc-path" textWrap="true" />
        <Button col="1" text="&#x2715;" tap="{{ onDocUnpinTap }}"
          visibility="{{ docUnpinVisibility }}" class="ghost-doc-close" />
      </GridLayout>
      <!--
        RENDERED MARKDOWN, NOT RAW TEXT (2026-09-03). Chris tapped a plain
        `knowledge/current-state.md` mention in Rich view, it opened here
        correctly, and then showed the file's markdown source verbatim —
        headings as "## ...", bullets as "- ...", nothing styled. Same gap
        cc-web's pinned-preview pane closed in session 0144, in the form a
        native pane can take: one Label per parsed block, styled by class,
        with the inline runs carried as a FormattedString. See
        markdown-render.ts for why marked + DOMPurify is not portable here.

        Not virtualized, same as Rich view's Repeater above — the view model
        caps the block count and says so in the last row rather than
        silently truncating.
      -->
      <ScrollView row="1">
        <StackLayout class="ghost-doc-body">
          <Repeater items="{{ docBlocks }}">
            <Repeater.itemsLayout>
              <StackLayout />
            </Repeater.itemsLayout>
            <Repeater.itemTemplate>
              <Label formattedText="{{ formatted }}" class="{{ blockClass }}" textWrap="true" />
            </Repeater.itemTemplate>
          </Repeater>
        </StackLayout>
      </ScrollView>
    </GridLayout>

    <!-- Settings: Ghost's real ConfigSettings, the same objects the glasses
         menu edits, so a change here shows up there and vice versa. -->
    <ScrollView visibility="{{ settingsPaneVisibility }}">
      <StackLayout class="ghost-pane-body">
        <Label text="Session" class="home-section-title" />
        <StackLayout class="ghost-setting">
          <Label text="Host" class="ghost-setting-label" />
          <Label text="Address of the box running cc-web" class="ghost-setting-desc" textWrap="true" />
          <TextField text="{{ ghostHost }}" hint="http://100.100.41.21:32352"
            autocorrect="false" autocapitalizationType="none" class="ghost-setting-field" />
        </StackLayout>
        <StackLayout class="ghost-setting">
          <Label text="Token" class="ghost-setting-label" />
          <Label text="Bearer token for the box's --auth. Empty sends no header at all." class="ghost-setting-desc" textWrap="true" />
          <TextField text="{{ ghostToken }}" secure="true"
            autocorrect="false" autocapitalizationType="none" class="ghost-setting-field" />
        </StackLayout>
        <StackLayout class="ghost-setting">
          <Label text="Session id" class="ghost-setting-label" />
          <Label text="Setting this by hand turns auto-follow off." class="ghost-setting-desc" textWrap="true" />
          <TextField text="{{ ghostSession }}" autocorrect="false" autocapitalizationType="none"
            class="ghost-setting-field" />
        </StackLayout>

        <Label text="Behaviour" class="home-section-title" />
        <GridLayout rows="auto" columns="*,auto" class="ghost-setting">
          <StackLayout col="0">
            <Label text="Follow active session" class="ghost-setting-label" />
            <Label text="Track whichever session the box has marked active." class="ghost-setting-desc" textWrap="true" />
          </StackLayout>
          <Switch col="1" checked="{{ autoFollow }}" checkedChange="{{ onAutoFollowChange }}" verticalAlignment="center" />
        </GridLayout>
        <GridLayout rows="auto" columns="*,auto" class="ghost-setting">
          <StackLayout col="0">
            <Label text="Speak replies" class="ghost-setting-label" />
            <Label text="Read new arrivals aloud through the phone's audio route." class="ghost-setting-desc" textWrap="true" />
          </StackLayout>
          <Switch col="1" checked="{{ speakReplies }}" checkedChange="{{ onSpeakChange }}" verticalAlignment="center" />
        </GridLayout>
      </StackLayout>
    </ScrollView>

  </GridLayout>

  <!-- The compose box: the one thing this screen does that the lens cannot,
       which is why it is docked rather than reached for. -->
  <GridLayout row="2" rows="auto,auto" columns="*,auto" class="ghost-compose" visibility="{{ composeVisibility }}">
    <!-- One line tall at rest, growing with what is typed (see .ghost-compose-
         input in app.css). A fixed 88dp box spent a tenth of the screen on
         emptiness on every pane. -->
    <TextView row="0" col="0" text="{{ composeText }}" hint="Type into the live session…"
      class="ghost-compose-input" />
    <Button row="0" col="1" text="Send" tap="{{ onSendTap }}" isEnabled="{{ sendEnabled }}"
      class="-primary ghost-send" verticalAlignment="bottom" />
    <Label row="1" colSpan="2" text="{{ composeStatus }}" visibility="{{ composeStatusVisibility }}"
      class="ghost-compose-status" textWrap="true" />
  </GridLayout>

</GridLayout>
