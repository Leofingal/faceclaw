<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" actionBarHidden="true">
    <GridLayout rows="*,auto" class="p-20">
        <StackLayout row="0" verticalAlignment="middle" visibility="{{ splashVisibility }}">
            <Label text="{{ headline }}" class="h1 text-center" textWrap="true" />
            <Label text="{{ tagline }}" class="body-text text-center m-t-8" textWrap="true" />
            <Image src="~/images/faceclaw-logo.png" stretch="aspectFit" height="{{ logoHeight }}" horizontalAlignment="center" class="onboarding-logo m-t-24" />
        </StackLayout>

        <ScrollView row="0" visibility="{{ contentVisibility }}">
            <StackLayout>
                <Label text="{{ headline }}" class="h1 text-center m-t-24" textWrap="true" />
                <Label text="{{ body }}" class="body-text m-t-24" textWrap="true" />
            </StackLayout>
        </ScrollView>

        <GridLayout row="1" columns="*,*" class="m-t-20">
            <Button col="0" text="{{ secondaryLabel }}" tap="{{ onSecondaryTap }}" visibility="{{ secondaryVisibility }}" />
            <Button col="1" text="{{ primaryLabel }}" tap="{{ onPrimaryTap }}" class="-primary" />
        </GridLayout>
    </GridLayout>
</Page>
